function saveEmployee(employee) {
  console.log("Received employee:", employee);

    console.log("SAVE EMPLOYEE CALLED");
    console.log(employee);

  // if (!employee) {
  //   throw new Error("Employee data is missing or undefined.");
  // }

  const row = [
    employee.employeeId,
    employee.name,
    employee.department,
    employee.designation,
    employee.salary
  ];

  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName("Employee Data");

  // V4: read existing employees
  const rows = sheet
    .getRange(1, 1, sheet.getLastRow(), sheet.getLastColumn())
    .getValues();

  // V4: build identity lookup
  const employeeIdSet = buildEmployeeIdSet(rows);



  // Log all existing employee IDs for debugging
  console.log("Existing Employee IDs:", Array.from(employeeIdSet));
  console.log("New Employee ID:", employee.employeeId);

  // V4: check identity
  const duplicate = isDuplicate(
    employee.employeeId,
    employeeIdSet
  );

  console.log("Is duplicate:", duplicate);

  // Existing V2 execution
  const nextRow = sheet.getLastRow() + 1;

  sheet
    .getRange(nextRow, 1, 1, row.length)
    .setValues([row]);
 }




